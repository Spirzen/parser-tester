# Файл для Netlify / Cloudflare Pages: настоящие HTTP-редиректы 301/302.
# На GitHub Pages он не работает (GitHub его игнорирует), поэтому на Pages
# урок про редиректы идёт через meta refresh и history.replaceState (см. http/redirect.html).
# Единственный источник правил редиректов для Netlify и Cloudflare Pages: сборка
# кладёт этот файл в dist, netlify.toml их дублировать не должен.
# Локальный tools/serve.mjs их не читает — там свои учебные эндпоинты /http/redirect-*.

/old/catalog.html        /selectors/products.html      301
/old/news                /http/index.html              302
/data/legacy.json        /data/products.json           301
/promo/2024              /pagination/index.html        302
/private/secrets.html    /404.html                     410
